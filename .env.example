# ─────────────────────────────────────────────────────────────────────────────
# .env — INFRASTRUCTURE ONLY (hosts, ports, credentials). Copy to .env and fill in.
# Model / feature / serving / alert settings live ONLY in params.yaml.
# `python scripts/init_env.py` creates .env with random secrets.
# ─────────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# Host ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
MODEL_SERVER_PORT=8001
MLFLOW_PORT=5000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
AIRFLOW_PORT=8080

# Browser origins allowed to call the backend (comma separated, no wildcard)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secrets (generate random values; never commit .env)
ADMIN_TOKEN=change-me                 # model server /admin/reload
WEBHOOK_TOKEN=change-me               # webhook /trigger (manual demo trigger)
AIRFLOW_ADMIN_USER=ddd_admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW__CORE__FERNET_KEY=change-me
AIRFLOW__WEBSERVER__SECRET_KEY=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Airflow runs as your host user so it can write to the mounted repo (`id -u`)
AIRFLOW_UID=1000
# DVC local remote: mounted at the SAME absolute path inside Airflow (matches .dvc/config)
DVC_REMOTE_DIR=/home/ritik/dvc_remote_ddd
